# Copie estas variables en Netlify: Site configuration → Environment variables.
# No escriba valores reales en este archivo ni lo renombre a .env dentro del repositorio.

# Servidor MySQL (ejemplo: ramnsoftware.com)
DB_NUBE=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Clave para firmar las sesiones: una cadena larga y aleatoria (mínimo 32 caracteres)
SESSION_SECRET=
